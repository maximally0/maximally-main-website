# ────────────────────────────────────────────────────────────────────
# MAXIMALLY — Environment Variables Reference
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# For production, set these in: Netlify Dashboard → Site Settings → Environment Variables
# ────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Email (Resend) ────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Without this, ALL emails (OTP, welcome, announcements, etc.) will silently fail
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@maximally.in

# ── Platform URLs ─────────────────────────────────────────────────────
# Used in email templates for CTAs and links
PLATFORM_URL=https://maximally.in
NODE_ENV=production

# ── Security ──────────────────────────────────────────────────────────
# Random token for the /api/admin/invite endpoint
# Generate with: openssl rand -hex 32
ADMIN_INVITE_TOKEN=your_secure_random_token_here

# ── reCAPTCHA (optional) ──────────────────────────────────────────────
# Get from: https://www.google.com/recaptcha/admin
# Without this, captcha verification returns 500 (safely caught)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ── Scheduled functions security ──────────────────────────────────────
# Protects /api/cron/* endpoints from unauthorized calls
SCHEDULER_SECRET=your_secure_scheduler_secret

# ── Dev-only overrides ────────────────────────────────────────────────
# Set SKIP_EMAIL_OTP=true ONLY in local .env, never in production.
# When true, OTP is hardcoded to "123456" — anyone can create accounts.
# SKIP_EMAIL_OTP=true

# Dev API target (only needed locally)
# VITE_USE_API=true
# VITE_API_URL=http://localhost:5000
